# Copy to /etc/peaker/lead.env and fill in. Keep this file private (chmod 600).
ODOO_URL=https://erp.yourdomain.com
ODOO_DB=your_database_name
ODOO_USER=website-leads@yourdomain.com
ODOO_API_KEY=paste-the-api-key-here
# Optional: the id of the CRM sales team that should receive website leads
LEAD_TEAM_ID=
BACKUP_CSV=/var/lib/peaker/leads.csv
PORT=8081
